# Bash configuration sourced by run.sh after PROJECT_DIR is detected.
# Always anchor outputs to this checkout, ignoring an inherited ROOT.
export ROOT="$PROJECT_DIR"

# Allow callers to select another interpreter with the required bindings.
export PY="${PY:-/home/asinha/tools/week8/venv/bin/python}"

# Use this checkout's entry point regardless of an inherited W9.
export W9="$ROOT/scripts/run_week9_spmv.py"
