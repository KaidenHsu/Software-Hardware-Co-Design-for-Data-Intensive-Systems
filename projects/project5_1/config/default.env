# Read-only installations. Environment overrides are allowed, for example:
#   PY=/path/to/python GEM5_ROOT=/path/to/gem5 ./run.sh --stage check
# An explicitly empty GCC_ENABLE skips the compiler setup script.

# Python must provide the Ramulator bindings and YAML package.
PY=${PY:-/home/asinha/tools/week8/venv/bin/python}

# Existing shared simulator installations are read, never rebuilt by this runner.
GEM5_ROOT=${GEM5_ROOT:-/home/asinha/gem5}
RAM_ROOT=${RAM_ROOT:-/home/asinha/tools/week8/ramulator2}

# Source this optional script before launching Python and compiler subprocesses.
GCC_ENABLE=${GCC_ENABLE-/opt/rh/gcc-toolset-13/enable}
